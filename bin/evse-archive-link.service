[Unit]
Description=Verify or reconnect one pinned EVSE web archive endpoint
After=docker.service
Requisite=docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/libexec/evse-archive-link --reconcile
StandardInput=file:/etc/evse-archive-link/expected
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=DOCKER_CONFIG=/etc/evse-archive-link/docker-config
TimeoutStartSec=45
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
