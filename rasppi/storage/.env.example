# Existing database: verify container/network/version before setting these.
# DB_HOST must be reachable inside DB_NETWORK; not Pi localhost.
DB_HOST=
DB_NETWORK=evse-data
DB_PORT=3306
DB_NAME=evse_control
DB_USERNAME=evse_storage
DB_MIGRATION_USERNAME=evse_migrator
DB_TIMEOUT_SECONDS=3
# Passwords go to dedicated files under secrets/, never commit them.
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=evse/wallbox
MQTT_CLIENT_ID=evse-storage
MQTT_USERNAME=
STORAGE_QUEUE_SIZE=256
# One persisted UTC minute product; HTTP/MQTT acquisition remains every two seconds.
# Explicit --migrate-minutes required before activating minute mode.
STORAGE_RECORDING_MODE=minute
# Retention in days: 0 = unlimited (no automatic deletion).
# A coarser finite tier must retain at least as long as the preceding tier.
# MINUTE also covers legacy raw observations/events; no prices/providers are touched.
STORAGE_RETENTION_MINUTE_DAYS=0
STORAGE_RETENTION_HOUR_DAYS=0
STORAGE_RETENTION_DAY_DAYS=0
# Optional direct HTTP house archive; empty URL disables polling. Explicit HOUSE migration required.
SMARTMETER_URL=
SMARTMETER_POLL_SECONDS=2
SMARTMETER_TIMEOUT_SECONDS=2
# Database identity only; retain your existing custom source key.
# If unset, legacy HOUSE_MQTT_TOPIC_PREFIX is used, then evse/house.
HOUSE_HISTORY_SOURCE=evse/house
