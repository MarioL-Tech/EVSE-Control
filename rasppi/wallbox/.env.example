# Copy to .env on the Pi. Never commit credentials.
WALLBOX_DEVICE=/dev/ttyUSBEVSEcontrol
WALLBOX_BAUD=57600
WALLBOX_PARITY=E
WALLBOX_SLAVE=9
WALLBOX_INTERVAL_MS=2000
WALLBOX_TIMEOUT_MS=1000

MQTT_ENABLED=true
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=evse/wallbox
MQTT_CLIENT_ID=evse-wallbox-reader
MQTT_USERNAME=
# Current broker test allowed anonymous publishing. For authentication prefer
# compose.auth.yaml with an existing password file outside the repository.
MQTT_PASSWORD=
