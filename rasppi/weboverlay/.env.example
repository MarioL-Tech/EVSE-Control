# Local file: test -e .env || cp .env.example .env
WEB_PORT=8080
WEB_STALE_SECONDS=10
# Optional, backend-only. Empty disables house-grid HTTP polling.
# Use your authorized meter URL, e.g. http://SMARTMETER-ADRESSE/dev/powerValue.txt
SMARTMETER_URL=
SMARTMETER_POLL_SECONDS=2
SMARTMETER_TIMEOUT_SECONDS=2
SMARTMETER_STALE_SECONDS=10
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=evse/wallbox
# Must differ from the wallbox-reader and other MQTT clients.
MQTT_CLIENT_ID=evse-weboverlay
MQTT_USERNAME=
MQTT_PASSWORD=
# Optional with compose.auth.yaml (file readable by container UID 10001):
# MQTT_PASSWORD_HOST_FILE=/absolute/path/outside/repository/mqtt-password
# Optional SQL history: compose.yaml + compose.history.yaml (plus MQTT auth overlay if used).
# Keep disabled until the chosen login AND its TCP/table access are verified.
WEB_HISTORY_ENABLED=0
HISTORY_DB_HOST=evse-database
HISTORY_DB_PORT=3306
HISTORY_DB_NAME=energyControl
HISTORY_DB_USERNAME=smartReader
DB_NETWORK=evse-data
# HISTORY_DB_PASSWORD_HOST_FILE=/absolute/path/outside/repository/history-reader-password
