# Local file: test -e .env || cp .env.example .env
WEB_PORT=8080
WEB_STALE_SECONDS=10
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=evse/wallbox
# Must differ from the wallbox-reader and other MQTT clients.
MQTT_CLIENT_ID=evse-weboverlay
MQTT_USERNAME=
MQTT_PASSWORD=
# Optional with compose.auth.yaml (file readable by container UID 10001):
# MQTT_PASSWORD_HOST_FILE=/absolute/path/outside/repository/mqtt-password
