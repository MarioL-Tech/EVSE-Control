# Local file: test -e .env || cp .env.example .env
WEB_PORT=8080
# Default: SSH tunnel only. For trusted LAN access, use the Pi's LAN IPv4 address.
# Keep deployment addresses only in your local .env; 0.0.0.0 exposes every interface.
WEB_BIND_ADDRESS=127.0.0.1
# Optional LAN-only HTTPS: uncomment to start the proxy with the website stack.
# COMPOSE_PROFILES=https
# HTTPS uses an internal CA only (no public ACME or automatic host trust).
# Trust ONLY the public root.crt on each device; never export private CA keys.
# HTTP above remains available: no redirect or HSTS is enabled.
WEB_HTTPS_PORT=443
# Empty inherits WEB_BIND_ADDRESS. Set explicitly if binding to 0.0.0.0.
# Accepts one IPv4 or ASCII DNS identity, no scheme/port/path/wildcard.
# Examples: 192.0.2.10 or evse.example.test (configure DNS separately).
# A future DNS identity still uses the internal CA, not implicit WAN issuance.
WEB_TLS_HOST=
WEB_STALE_SECONDS=10
# Optional, backend-only. Empty disables house-grid HTTP polling.
# Use your authorized meter URL, e.g. http://SMARTMETER-ADRESSE/dev/powerValue.txt
SMARTMETER_URL=
SMARTMETER_POLL_SECONDS=2
SMARTMETER_TIMEOUT_SECONDS=2
SMARTMETER_STALE_SECONDS=10
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=evse/wallbox
# Must differ from the wallbox-reader and other MQTT clients.
MQTT_CLIENT_ID=evse-weboverlay
MQTT_USERNAME=
MQTT_PASSWORD=
# Trusted-LAN editor, NO LOGIN. Provision first: bash docker/setup-settings.sh
# Set 0 to disable. Saving never recreates containers.
SETTINGS_EDITOR_ENABLED=1
# Empty uses the configured HTTP bind address and port. For HTTPS set exact origin.
SETTINGS_EDITOR_ORIGIN=
# Optional with compose.auth.yaml (file readable by container UID 10001):
# MQTT_PASSWORD_HOST_FILE=/absolute/path/outside/repository/mqtt-password
# Optional SQL history: compose.yaml + compose.history.yaml (plus MQTT auth overlay if used).
# Keep disabled until the chosen login AND its TCP/table access are verified.
WEB_HISTORY_ENABLED=0
# Durable house archive: explicit HOUSE migration and storage HTTP polling first.
WEB_HOUSE_HISTORY_ENABLED=0
# Database identity only; match storage and retain your existing custom source key.
# If unset, legacy HOUSE_MQTT_TOPIC_PREFIX is used, then evse/house.
HOUSE_HISTORY_SOURCE=evse/house
HISTORY_DB_HOST=evse-database
HISTORY_DB_PORT=3306
HISTORY_DB_NAME=energyControl
HISTORY_DB_USERNAME=smartReader
DB_NETWORK=evse-data
# HISTORY_DB_PASSWORD_HOST_FILE=/absolute/path/outside/repository/history-reader-password
