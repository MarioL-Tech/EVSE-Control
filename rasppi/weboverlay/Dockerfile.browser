# Browser tests run only in this disposable test image, never on the Pi host.
FROM mcr.microsoft.com/playwright:v1.55.0-noble
WORKDIR /tests
RUN apt-get update && apt-get install -y --no-install-recommends libnss3-tools ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --no-audit --no-fund --save-exact playwright@1.55.0
COPY tests/browser.cjs ./
COPY tests/wallbox-control-browser.cjs ./
COPY tests/charging-settings-browser.cjs ./
COPY tests/esp32-browser.cjs ./
COPY tests/charts-browser.cjs ./
COPY tests/layout-browser.cjs ./
COPY tests/theme-browser.cjs ./
COPY tests/smartmeter-browser.cjs ./
COPY tests/history-browser.cjs ./
COPY tests/house-history-browser.cjs ./
COPY tests/pwa*.cjs ./
COPY tests/generate-icons.cjs tests/run-pwa-browser.sh ./
COPY static/icon.svg /static/icon.svg
COPY static/service-worker.js /static/service-worker.js
COPY static/charts.js /static/charts.js
COPY static/newcalendar.js /static/newcalendar.js
COPY static/history.js /static/history.js
COPY static/house-history.js /static/house-history.js
CMD ["sh", "-c", "status=0; for suite in browser.cjs charts-browser.cjs layout-browser.cjs theme-browser.cjs smartmeter-browser.cjs history-browser.cjs house-history-browser.cjs wallbox-control-browser.cjs charging-settings-browser.cjs esp32-browser.cjs; do echo Browser-suite: $suite; node \"$suite\" || status=1; done; exit \"$status\""]
