# Browser tests run only in this disposable test image, never on the Pi host.
FROM mcr.microsoft.com/playwright:v1.55.0-noble
WORKDIR /tests
RUN apt-get update && apt-get install -y --no-install-recommends libnss3-tools ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --no-audit --no-fund --save-exact playwright@1.55.0
COPY tests/browser.cjs ./
COPY tests/wallbox-control-browser.cjs ./
COPY tests/charging-settings-browser.cjs ./
COPY tests/esp32-browser.cjs ./
COPY tests/charging-mode-browser.cjs ./
COPY tests/charts-browser.cjs ./
COPY tests/layout-browser.cjs ./
COPY tests/gui-evidence-browser.cjs ./
COPY tests/theme-browser.cjs ./
COPY tests/smartmeter-browser.cjs ./
COPY tests/history-browser.cjs ./
COPY tests/house-history-browser.cjs ./
COPY tests/pwa*.cjs ./
COPY tests/generate-icons.cjs tests/run-pwa-browser.sh ./
# Expected bytes from this checkout. Actual pages/assets are still served by
# the separate runtime image (HTTPS for PWA); no browser file:// fallback.
COPY static/ /static/
RUN for suite in *.cjs; do node --check "$suite" || exit 1; done
CMD ["sh", "-c", "status=0; for suite in browser.cjs charts-browser.cjs layout-browser.cjs theme-browser.cjs smartmeter-browser.cjs history-browser.cjs house-history-browser.cjs wallbox-control-browser.cjs charging-settings-browser.cjs esp32-browser.cjs charging-mode-browser.cjs; do echo Browser-suite: $suite; node \"$suite\" || status=1; done; exit \"$status\""]
