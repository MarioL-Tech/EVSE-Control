# Line endings: repo always stores LF; Windows CRLF on disk is normalized by git
* text=auto
*.md text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
Dockerfile* text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
